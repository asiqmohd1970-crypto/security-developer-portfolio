# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: Optional Python Flask API URL for frontend (leave empty for same-origin proxy)
VITE_API_URL=

# Email Dispatch Configuration (Optional - for direct Python Flask SMTP email delivery)
# To use Gmail SMTP, create a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=asiqmohd1970@gmail.com
SMTP_PASS=
RECIPIENT_EMAIL=asiqmohd1970@gmail.com
